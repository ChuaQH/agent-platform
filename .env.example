# ── ACA Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is loaded automatically if present in the project root.
#
# Priority: shell env vars > .env file > .agent-config.yml > defaults
# ───────────────────────────────────────────────────────────────────────

# ── LLM ───────────────────────────────────────────────────────────────
# Required: Your DeepSeek API key
DEEPSEEK_API_KEY=sk-...

# Optional: Override LLM settings
# ACA_LLM_PROVIDER=deepseek
# ACA_LLM_MODEL=deepseek-chat
# ACA_LLM_BASE_URL=https://api.deepseek.com
# ACA_LLM_MAX_TOKENS=8192
# ACA_LLM_TEMPERATURE=0.0
# ACA_LLM_TIMEOUT=120.0        # Per LLM call timeout in seconds

# ── Tools (API Keys) ──────────────────────────────────────────────────
# Brave Search API key (for assistant web_search tool)
# Free tier: 2,000 queries/month. Get yours at https://brave.com/search/api/
BRAVE_API_KEY=BSA-...

# ── Authentication (Google OAuth) ───────────────────────────────────────
# Required for Google sign-in. Get credentials at https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Required for Chainlit auth. Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=your-generated-secret

# ── Agent Behavior ────────────────────────────────────────────────────
# ACA_MAX_AGENT_TURNS=10         # Max LLM turns per chat request (legacy name: ACA_MAX_TOOL_CALLS)
# ACA_MAX_SUBAGENT_TURNS=20      # Max turns for a subagent before forced termination
# ACA_TOOL_TIMEOUT=30            # Timeout per tool execution (seconds)
# ACA_COMPRESS_THRESHOLD=0.8     # Compress conversation at this % of context window

# ── Caching ───────────────────────────────────────────────────────────
# ACA_DISK_CACHE_TTL=3600        # L2 disk cache TTL (seconds)
# ACA_DISK_CACHE_MAX_MB=500      # Max L2 cache size (MB)

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection URL (used by assistant + future aca)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform

# PostgreSQL integration tests use a dedicated database (created/dropped
# automatically by the test fixtures; the development database is never
# touched).
# ACA_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform_test

# ── Memory ────────────────────────────────────────────────────────────
# ACA_RECENT_OUTCOMES=15         # Number of recent outcomes to load
# ACA_RECENT_SESSIONS=5          # Number of recent sessions to load
# ACA_WEEKLY_DIGEST_AGE=7        # Days before sessions → weekly digest
# ACA_MONTHLY_DIGEST_AGE=30      # Days before sessions → monthly digest

# ── Logging ───────────────────────────────────────────────────────────
# ACA_LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR
# ACA_LOG_FILE=agent-data/logs/aca.log
# ACA_LOG_FORMAT=json            # json or text
